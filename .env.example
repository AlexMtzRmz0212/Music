# Copy to `.env` (gitignored) and fill what you need. Tools whose settings are missing
# show up greyed out in the UI and say what they are missing.

# Password for the private hub (the lock icon). Empty = login off locally;
# on Vercel an empty password makes every protected route answer 503 on purpose.
OWNER_PASSWORD=

# Notion integration for the "most streamed" tables (Streams tools)
NOTION_SECRET=
STREAMED_SONGS_DB_ID=
STREAMED_ALBUMS_DB_ID=

# Notion integration for your personal album library (sorter / decorator / stats)
# (old names API_KEY and ALBUM_DB_ID still work)
NOTION_ALBUMS_SECRET=
ALBUMS_LIBRARY_DB_ID=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

SETLISTFM_API_KEY=
GENIUS_TOKEN=
